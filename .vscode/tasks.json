{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LKM (ARM)",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/WS_kernel_module"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean LKM",
            "type": "shell",
            "command": "make clean",
            "options": {
                "cwd": "${workspaceFolder}/WS_kernel_module"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}